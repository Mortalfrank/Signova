HOST=127.0.0.1
PORT=5178

# 阿里云百炼密钥；只能填在本地 .env，不能提交 Git 或粘贴到前端。
# 国内北京区域配置。其它地域需同时修改密钥、文本地址与语音地址。
DASHSCOPE_API_KEY=
AI_PROVIDER=dashscope
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-plus
AI_ENABLE_THINKING=false

# 实时语音识别复用上面的百炼密钥。具体模型需在所选区域可调用。
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# 可选：分别覆盖文本和语音服务密钥。
AI_API_KEY=
ASR_API_KEY=
